# BAMLOOP uses a separate YouTube channel and OAuth grant.
REMOTION_ENABLED=false
REMOTION_SMOKE_ON_START=false
PEXELS_API_KEY=
MEME_OUTPUT_DIR=storage/bamloop
MEME_YOUTUBE_ENABLED=false
MEME_YOUTUBE_CLIENT_ID=
MEME_YOUTUBE_CLIENT_SECRET=
MEME_YOUTUBE_EXPECTED_CHANNEL_ID=
MEME_YOUTUBE_REFRESH_TOKEN=
MEME_YOUTUBE_PRIVACY_STATUS=private

MEME_DB_PATH=/data/bamloop/bamloop.sqlite3
MAX_SHORTS_PER_DAY=5
MIN_HOURS_BETWEEN_SHORTS=3
PUBLISH_QUEUE_ENABLED=true
SMART_PUBLISH_SCHEDULING=true
CHANNEL_TIMEZONE=Europe/Istanbul
BAMLOOP_MEME_WEIGHT=1
BAMLOOP_AI_STORY_WEIGHT=1
BAMLOOP_DAILY_AI_BUDGET_USD=0
BAMLOOP_STORY_PROVIDER=local
BAMLOOP_IMAGE_PROVIDER=local
BAMLOOP_VIDEO_PROVIDER=local
BAMLOOP_MUSIC_FILE=
BAMLOOP_ZERO_COST_MODE=true
BAMLOOP_STORY_SCENE_SECONDS=9
BAMLOOP_AI_ESTIMATED_COST_USD=0
