MPT_API_URL=http://host.docker.internal:8080/api/v1
MPT_API_KEY=CHANGE_ME

# Generate separate Turkish and global-English editions.
NEWS_LANGUAGES=tr,en
NEWS_QUERIES=Galatasaray transfer,Fenerbahçe transfer,Beşiktaş transfer,Trabzonspor transfer,Türkiye futbol son dakika
NEWS_GLOBAL_QUERIES=football breaking news,football transfer news,Premier League latest news,Champions League latest news,Real Madrid Barcelona latest news

NEWS_POLL_SECONDS=300
NEWS_MAX_AGE_MINUTES=90
NEWS_MIN_SOURCES=2
NEWS_TITLE_SIMILARITY=0.52
NEWS_FETCH_WORKERS=5
NEWS_DRY_RUN=true
NEWS_DB_PATH=/data/viral_futbol.sqlite3
NEWS_MAX_INFLIGHT_TASKS=2
NEWS_MAX_TASK_ATTEMPTS=3
NEWS_RETRY_DELAY_SECONDS=300
NEWS_SUBMISSION_STALE_SECONDS=300
MPT_REQUEST_TIMEOUT=30

# V2 trend intelligence. External MCP/API adapters are connected later;
# these switches let us stage the scoring layer without risking production.
NEWS_TREND_INTELLIGENCE=false
NEWS_TREND_AUTO_SCORE=70
NEWS_TREND_HOLD_SCORE=50
NEWS_SOCIAL_VELOCITY_THRESHOLD=0.70

NEWS_VOICE=tr-TR-AhmetNeural-Male
NEWS_EN_VOICE=en-US-GuyNeural-Male
NEWS_VIDEO_SOURCE=pexels

# Fast-quality profile: the Colab launcher exports crisp 720x1280 video, while
# longer source cuts and varied transitions reduce work without looking static.
NEWS_VIDEO_CLIP_DURATION=5
NEWS_VOICE_RATE=1.03

# Keep music disabled until verified tracks from YouTube Audio Library have
# been placed in MoneyPrinterTurbo's storage/bgm directory.
NEWS_BGM_TYPE=
NEWS_BGM_VOLUME=0.10
